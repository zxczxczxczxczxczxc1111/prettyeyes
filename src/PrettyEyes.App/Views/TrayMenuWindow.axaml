<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PrettyEyes.App.Views.TrayMenuWindow"
        Title="prettyeyes"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        Background="{StaticResource Bg}">
  <Border x:Name="Card"
          Background="{StaticResource SurfaceRaised}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          Padding="6"
          Opacity="0"
          Width="190">
    <Border.RenderTransform>
      <TranslateTransform Y="6"/>
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>

    <StackPanel Spacing="2">
      <Button x:Name="CaptureItem" Classes="menu" Content="Скриншот"/>
      <!-- Only there when there is a folder to open: autosave writes silently,
           and "somewhere on the disk" is not an answer. -->
      <Button x:Name="OpenFolderItem" Classes="menu" Content="Папка скриншотов" IsVisible="False"/>
      <!-- Only there once a newer release has actually been found: an entry
           that is grey nine days out of ten teaches people to ignore it. -->
      <Button x:Name="UpdateItem" Classes="menu" IsVisible="False"/>
      <!-- Only there while something is pinned: two entries that are grey
           most of the time are two entries nobody reads. -->
      <Button x:Name="ShowPinsItem" Classes="menu" Content="Показать все закреплённые" IsVisible="False"/>
      <Button x:Name="ClosePinsItem" Classes="menu" Content="Закрыть все закреплённые" IsVisible="False"/>
      <Button x:Name="SettingsItem" Classes="menu" Content="Настройки"/>
      <Rectangle Height="1" Margin="8,4" Fill="{StaticResource Border}"/>
      <Button x:Name="ExitItem" Classes="menu" Content="Выход"/>
    </StackPanel>
  </Border>
</Window>
