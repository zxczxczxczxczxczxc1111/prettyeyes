<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PrettyEyes.App.Controls"
        xmlns:views="using:PrettyEyes.App.Views"
        x:Class="PrettyEyes.App.Views.PinnedWindow"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="Transparent"
        CanResize="False">
  <Window.Styles>
    <!-- Local copies rather than shared ones: Button.tool lives inside the
         toolbar's own styles and Button.menu inside the tray menu's, and
         neither reaches a control that is not their child. -->
    <!-- The cross, built like the toolbar's own buttons rather than invented
         again: same size, same radius, content centred. Left to itself a
         Button puts its content in the top left corner, which is exactly how
         the first version came out crooked. -->
    <Style Selector="Button.chrome">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillHover}"/>
    </Style>
    <Style Selector="Button.chrome Path">
      <Setter Property="Stroke" Value="{StaticResource Text}"/>
      <Setter Property="StrokeThickness" Value="1.4"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
    </Style>
    <Style Selector="Button.chrome:pointerover Path">
      <Setter Property="Stroke" Value="{StaticResource TextStrong}"/>
    </Style>

    <Style Selector="Button.answer">
      <Setter Property="Height" Value="30"/>
      <!-- Both answers the same width, so the pair reads as a pair rather than
           as two buttons that happened to land next to each other. -->
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Padding" Value="12,0"/>
      <!-- Avalonia puts button content in the top left corner unless told
           otherwise, and a label sitting above the middle of a 30 pixel button
           is exactly what "slightly crooked" looks like. The same two lines
           were missing from the close cross once already. -->
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Background" Value="{StaticResource Fill}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
      <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    </Style>
    <Style Selector="Button.answer:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillHover}"/>
    </Style>
  </Window.Styles>

  <Panel x:Name="Root">
    <controls:PinnedCanvas x:Name="Surface"/>

    <!-- A hairline so a screenshot pinned over a window of the same colour is
         still a thing with edges rather than a hole in the desktop. -->
    <Border BorderBrush="{StaticResource Border}" BorderThickness="1" IsHitTestVisible="False"/>

    <!-- The only piece of chrome a pin has. It appears with the toolbar, for
         the same reason: a stack of pins should not be a stack of buttons. -->
    <Button x:Name="CloseButton" Classes="chrome" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,10,10,0" IsVisible="False" ToolTip.Tip="Закрыть">
      <Path Data="M0,0 L9,9 M9,0 L0,9"/>
    </Button>

    <!-- Dims the picture, the toolbar and the close cross while a question is
         up, because all three stop answering and nothing said so. -->
    <Rectangle x:Name="Scrim" IsVisible="False" Fill="#99000000"/>

    <Border x:Name="ConfirmBar" IsVisible="False"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{StaticResource SurfaceRaised}"
            BorderBrush="{StaticResource Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource RCard}"
            Padding="16,12">
      <StackPanel Spacing="10">
        <TextBlock x:Name="ConfirmText" Foreground="{StaticResource TextStrong}"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="KeepButton" Classes="answer" Content="Оставить"/>
          <Button x:Name="DiscardButton" Classes="answer" Content="Закрыть"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <views:ToolbarView x:Name="Toolbar" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       Margin="0,0,0,8" IsVisible="False"/>
    <views:ToolStylePopup x:Name="StyleCard" HorizontalAlignment="Left" VerticalAlignment="Top"
                          IsVisible="False"/>
    <views:EmojiPickerView x:Name="EmojiCard" HorizontalAlignment="Left" VerticalAlignment="Top"
                           IsVisible="False"/>
  </Panel>
</Window>
