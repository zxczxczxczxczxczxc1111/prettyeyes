<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PrettyEyes.App.Controls"
        x:Class="PrettyEyes.App.Views.SettingsWindow"
        Title="prettyeyes"
        Icon="/Assets/prettyeyes.ico"
        Width="880" Height="920"
        CanResize="False"
        SystemDecorations="None"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          Opacity="0">
    <Border.RenderTransform>
      <TranslateTransform Y="6"/>
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <Panel>
    <DockPanel>
      <Grid DockPanel.Dock="Top" x:Name="TitleBar" Height="44" ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="/Assets/prettyeyes.ico" Width="16" Height="16" Margin="16,0,0,0"/>
        <TextBlock Grid.Column="1" Text="prettyeyes" Margin="10,0,0,0"
                   VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
        <Button Grid.Column="2" x:Name="CloseButton" Classes="ghost close"
                Margin="0,0,10,0" Content="✕"/>
      </Grid>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- Two columns, nothing folded away. The window is opened to set
             things up and closed again, so it can afford the room; a setting
             that has to be hunted for is worse than a wide window. -->
        <Grid Margin="32,8,32,32" ColumnDefinitions="400,32,400" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Grid.Row="0" Spacing="20">
            <StackPanel Spacing="12">
              <TextBlock Text="Скриншот" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>

              <StackPanel Spacing="8">
                <TextBlock Text="Выделить область" Foreground="{StaticResource Text}"/>
                <controls:HotkeyBox x:Name="RegionHotkey" Classes="field" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Весь монитор в буфер" Foreground="{StaticResource Text}"/>
                <controls:HotkeyBox x:Name="FullScreenHotkey" Classes="field" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Курсор" Foreground="{StaticResource Text}"/>
                <TextBlock Text="Вид указателя при выделении. Светлеет на тёмном и темнеет на светлом."
                           Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"/>
                <!-- Filled from code: the shapes are the same strings the
                     cursors themselves are drawn from. -->
                <StackPanel x:Name="CursorRow" Orientation="Horizontal" Spacing="8"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Лупа" Foreground="{StaticResource Text}"/>
                <TextBlock Text="Увеличение под курсором, пока идёт выделение. Наведи, чтобы прочитать название."
                           Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"/>
                <!-- One row, three states, exactly one on: off, on, on with the
                     pixel grid. A grid checkbox nested under a magnifier
                     checkbox said the same thing in two controls, one of which
                     spent most of its life greyed out. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="MagnifierOff" Classes="toolpick" ToolTip.Tip="Без лупы">
                    <Path Data="M7,2.5 A4.5,4.5 0 1 0 7.01,2.5 M10.3,10.3 L13.5,13.5 M3.2,10.8 L10.8,3.2"/>
                  </Button>
                  <Button x:Name="MagnifierPlain" Classes="toolpick" ToolTip.Tip="Лупа">
                    <Path Data="M7,2.5 A4.5,4.5 0 1 0 7.01,2.5 M10.3,10.3 L13.5,13.5"/>
                  </Button>
                  <Button x:Name="MagnifierWithGrid" Classes="toolpick" ToolTip.Tip="Лупа с сеткой пикселей">
                    <Path Data="M7,2.5 A4.5,4.5 0 1 0 7.01,2.5 M10.3,10.3 L13.5,13.5 M4.5,5.5 H9.5 M4.5,8.5 H9.5 M5.5,4.5 V9.5 M8.5,4.5 V9.5"/>
                  </Button>
                </StackPanel>
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource Border}"/>

            <StackPanel Spacing="12">
              <TextBlock Text="Панель инструментов" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <TextBlock Text="Выключенное не появится в панели при выделении. Наведи, чтобы прочитать название."
                         Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"/>
              <!-- The same icons the toolbar draws, in the same order, so the
                   setting is read as a picture of the toolbar rather than as a
                   list that happens to be about it. Filled from code: the list
                   cannot then drift from the tools that actually exist. -->
              <StackPanel x:Name="ToolRow" Orientation="Horizontal" Spacing="8"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource Border}"/>

            <StackPanel Spacing="12">
              <TextBlock Text="Быстрое сохранение" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <!-- Says what it does, because the group heading reads like a
                   place to pick a folder for the save dialog, and it is not:
                   nothing here changes what Ctrl+S does. -->
              <TextBlock Text="Каждый скопированный скриншот сразу ложится файлом в папку, без диалога и уведомлений. Буфер обмена работает как раньше."
                         Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"/>
              <CheckBox x:Name="Autosave" Content="Сохранять скриншоты в папку"/>

              <StackPanel x:Name="AutosaveOptions" Spacing="12" Opacity="0.4" IsEnabled="False">
                <StackPanel Spacing="8">
                  <TextBlock Text="Папка" Foreground="{StaticResource Text}"/>
                  <Grid ColumnDefinitions="*,8,Auto">
                    <TextBox x:Name="SaveFolder" Grid.Column="0" Classes="field" IsReadOnly="True"
                             Watermark="не выбрана"/>
                    <Button x:Name="PickFolder" Grid.Column="2" Classes="ghost" Content="Выбрать"/>
                  </Grid>
                </StackPanel>

                <StackPanel Spacing="8">
                  <TextBlock Text="Имя файла" Foreground="{StaticResource Text}"/>
                  <TextBox x:Name="SaveTemplate" Classes="field"/>
                  <TextBlock x:Name="SaveExample" Foreground="{StaticResource TextFaint}" FontSize="11"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>

          </StackPanel>

          <StackPanel Grid.Column="2" Grid.Row="0" Spacing="20">
            <StackPanel Spacing="12">
              <TextBlock Text="Система" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <CheckBox x:Name="Autostart" Content="Запускать вместе с Windows"/>
              <CheckBox x:Name="CheckUpdates" Content="Проверять обновления"/>

              <!-- The button and what it found, side by side: a status line
                   somewhere else on the window belongs to no control. -->
              <Grid ColumnDefinitions="Auto,12,*">
                <Button x:Name="CheckNow" Grid.Column="0" Classes="ghost" Content="Проверить сейчас"/>
                <TextBlock x:Name="UpdateStatus" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"/>
              </Grid>

              <!-- What to install, and what is in it. The second one is there
                   whether or not an update is: reading the notes is also how
                   somebody decides they do not want it. -->
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                <Button x:Name="InstallUpdate" Classes="ghost" IsVisible="False"/>
                <Button x:Name="OpenReleases" Classes="ghost" Content="Что нового"/>
              </StackPanel>

              <TextBlock x:Name="CurrentVersion" Foreground="{StaticResource TextFaint}" FontSize="11"/>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource Border}"/>

            <StackPanel Spacing="12">
            <TextBlock Text="Оформление" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
            <CheckBox x:Name="ExportEnabled" Content="Оформлять скриншот при выводе"/>

            <StackPanel x:Name="ExportOptions" Spacing="12" Opacity="0.4" IsEnabled="False">
              <StackPanel Spacing="8">
                <TextBlock Text="Поля" Foreground="{StaticResource Text}"/>
                <StackPanel x:Name="PaddingRow" Orientation="Horizontal" Spacing="6"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Фон" Foreground="{StaticResource Text}"/>
                <StackPanel x:Name="BackgroundRow" Orientation="Horizontal" Spacing="6"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Скругление" Foreground="{StaticResource Text}"/>
                <StackPanel x:Name="RadiusRow" Orientation="Horizontal" Spacing="6"/>
              </StackPanel>

              <CheckBox x:Name="ExportShadow" Content="Тень"/>

              <!-- Drawn by the same code that writes the file: a preview that
                   lies is worse than no preview. -->
              <Border Background="{StaticResource Bg}"
                      BorderBrush="{StaticResource Border}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource RField}"
                      Padding="8"
                      HorizontalAlignment="Left">
                <Image x:Name="ExportPreview" Width="176" Height="110"/>
              </Border>
            </StackPanel>
          </StackPanel>
          </StackPanel>

          <TextBlock x:Name="Message" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0"
                     FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
        </Grid>
      </ScrollViewer>
    </DockPanel>

      <!-- The mark, in the corner where a signature goes, and dimmed: it is the
           last thing on this window that should catch the eye.

           It sits over the whole card rather than in the scrolling content, so
           the 32 px below it is the same 32 px as to its right. Inside the
           content the bottom gap was whatever the settings happened not to fill,
           which read as crooked. The file itself is cropped to the ink for the
           same reason. -->
      <Image Source="/Assets/logo.png" Height="96" Opacity="0.85"
             Margin="32" IsHitTestVisible="False"
             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Panel>
  </Border>
</Window>
