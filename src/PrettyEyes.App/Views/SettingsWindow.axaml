<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PrettyEyes.App.Controls"
        xmlns:views="using:PrettyEyes.App.Views"
        x:Class="PrettyEyes.App.Views.SettingsWindow"
        Title="prettyeyes"
        Icon="/Assets/prettyeyes.ico"
        Width="880" Height="640"
        CanResize="False"
        SystemDecorations="None"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen">
  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          Opacity="0">
    <Border.RenderTransform>
      <TranslateTransform Y="6"/>
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <Panel>
    <DockPanel>
      <Grid DockPanel.Dock="Top" x:Name="TitleBar" Height="44" ColumnDefinitions="Auto,*,Auto">
        <Image Grid.Column="0" Source="/Assets/prettyeyes.ico" Width="16" Height="16" Margin="16,0,0,0"/>
        <TextBlock Grid.Column="1" Text="prettyeyes" Margin="10,0,0,0"
                   VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12"/>
        <Button Grid.Column="2" x:Name="CloseButton" Classes="ghost close"
                Margin="0,0,10,0" Content="✕"/>
      </Grid>

      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <!-- Two columns, nothing folded away. The window is opened to set
             things up and closed again, so it can afford the room; a setting
             that has to be hunted for is worse than a wide window. -->
        <Grid Margin="32,8,32,32" ColumnDefinitions="400,32,400" RowDefinitions="Auto,Auto">
          <StackPanel Grid.Column="0" Grid.Row="0" Spacing="30">
            <StackPanel Spacing="12">
              <TextBlock Text="Скриншот" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>

              <StackPanel Spacing="8">
                <TextBlock Text="Выделить область" Foreground="{StaticResource Text}"/>
                <controls:HotkeyBox x:Name="RegionHotkey" Classes="field" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <StackPanel Spacing="8">
                <TextBlock Text="Весь монитор в буфер" Foreground="{StaticResource Text}"/>
                <controls:HotkeyBox x:Name="FullScreenHotkey" Classes="field" HorizontalAlignment="Stretch"/>
              </StackPanel>

              <!-- Beside the two combinations it lists, rather than alone at the
                   bottom of the other column: down there it was a section with a
                   divider and a single button in it. -->
              <Button x:Name="ShowKeys" Classes="action" Content="Все сочетания клавиш"
                      HorizontalAlignment="Left" Margin="0,4,0,0"/>

            </StackPanel>

            <StackPanel Spacing="12">
              <TextBlock Text="Панель инструментов" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <TextBlock Text="Выключенное не появится в панели при выделении. Наведи, чтобы прочитать название. Уголок значит, что у иконки есть свои настройки: правый клик по ней, здесь или в самой панели."
                         Foreground="{StaticResource TextFaint}" FontSize="11" TextWrapping="Wrap"/>
              <!-- The same icons the toolbar draws, in the same order, so the
                   setting is read as a picture of the toolbar rather than as a
                   list that happens to be about it. Filled from code: the list
                   cannot then drift from the tools that actually exist. -->
              <TextBlock Text="Рисование" Foreground="{StaticResource TextFaint}" FontSize="11"/>
              <StackPanel x:Name="ToolRow" Orientation="Horizontal" Spacing="8"/>
              <!-- Second row, same shapes: features are not tools, they never
                   enter ToolVisibility and the last-one-standing rule does not
                   apply to them. Two rows say that without a paragraph. -->
              <TextBlock Text="Функции" Foreground="{StaticResource TextFaint}" FontSize="11"/>
              <StackPanel x:Name="FeatureRow" Orientation="Horizontal" Spacing="8"/>

              <!-- Out in the open rather than behind a right click: this is a
                   setting about the toolbar itself, not about one icon on it. -->
              <TextBlock Text="Инструмент сразу после выделения" Foreground="{StaticResource TextDim}"
                         FontSize="12" FontWeight="Medium" Margin="0,8,0,0"/>
              <StackPanel x:Name="DefaultToolRow" Orientation="Horizontal" Spacing="8"/>
            </StackPanel>

          </StackPanel>

          <StackPanel Grid.Column="2" Grid.Row="0" Spacing="30">
            <StackPanel Spacing="12">
              <TextBlock Text="Система" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <CheckBox x:Name="Autostart" Content="Запускать вместе с Windows"/>
              <CheckBox x:Name="CheckUpdates" Content="Проверять обновления"/>

              <!-- The button and what it found, side by side: a status line
                   somewhere else on the window belongs to no control. -->
              <Grid ColumnDefinitions="Auto,12,*">
                <Button x:Name="CheckNow" Grid.Column="0" Classes="action" Content="Проверить сейчас"/>
                <TextBlock x:Name="UpdateStatus" Grid.Column="2" VerticalAlignment="Center"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{StaticResource TextDim}"/>
              </Grid>

              <!-- What to install, and what is in it. The second one is there
                   whether or not an update is: reading the notes is also how
                   somebody decides they do not want it. -->
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                <Button x:Name="InstallUpdate" Classes="action" IsVisible="False"/>
                <Button x:Name="OpenReleases" Classes="action" Content="Что нового"/>
              </StackPanel>

              <TextBlock x:Name="CurrentVersion" Foreground="{StaticResource TextFaint}" FontSize="11"/>
            </StackPanel>

            <!-- How much has happened. Nothing here is wrong or right. -->
            <StackPanel Spacing="12">
              <TextBlock Text="Снимки" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>
              <StackPanel x:Name="Counters" Spacing="8"/>
            </StackPanel>

            <!-- What used to be a whole block called "Состояние" and mostly
                 restated the obvious: an application that runs is working, and
                 the folder it saves into has a button to it right here. What
                 stayed is the number somebody might genuinely want to see, plus
                 a line that appears only when the capture is NOT fine - the
                 answer to "the yellow frame is back" has to live somewhere
                 outside the log file. -->
            <StackPanel Spacing="12">
              <TextBlock Text="Скорость" Foreground="{StaticResource TextDim}" FontSize="12" FontWeight="Medium"/>

              <!-- Filled from code: what it says depends on what has happened
                   since start-up. -->
              <StackPanel x:Name="Health" Spacing="8"/>

              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                <Button x:Name="OpenLog" Classes="action" Content="Журнал"/>
                <Button x:Name="OpenShots" Classes="action" Content="Папка снимков"/>
              </StackPanel>
            </StackPanel>

            <!-- On its own, away from the two that merely open a folder: this
                 one throws away everything the person set up. -->
            <StackPanel Spacing="8">
              <Button x:Name="ResetSettings" Classes="action" Content="Настройки по умолчанию"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>

          <TextBlock x:Name="Message" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0"
                     FontSize="12" TextWrapping="Wrap" IsVisible="False"/>
        </Grid>
      </ScrollViewer>
    </DockPanel>

      <!-- The mark, in the corner where a signature goes, and dimmed: it is the
           last thing on this window that should catch the eye.

           It sits over the whole card rather than in the scrolling content, so
           the gap around it does not depend on how much the settings happened
           to fill. At the top right rather than the bottom: once the
           sections moved into their cards the page grew short, and a mark left
           at the bottom read as forgotten rather than as a signature. Up here
           it sits beside the first line of the right column, where the eye
           already is. The file itself is cropped to the ink for the same
           reason. -->
      <Image Source="/Assets/logo.png" Height="72" Opacity="0.85"
             Margin="0,58,28,0" IsHitTestVisible="False"
             HorizontalAlignment="Right" VerticalAlignment="Top"/>

      <!-- Last child of the panel, so it covers everything above it including
           the mark. Hidden until something asks for it. -->
      <views:SettingsModal x:Name="Modal"/>
    </Panel>
  </Border>
</Window>
