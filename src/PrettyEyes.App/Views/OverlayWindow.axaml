<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:PrettyEyes.App.Controls"
        x:Class="PrettyEyes.App.Views.OverlayWindow"
        SystemDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Black"
        CanResize="False">
  <Panel x:Name="Root">
    <controls:CaptureCanvas x:Name="Surface"/>
  </Panel>
</Window>
