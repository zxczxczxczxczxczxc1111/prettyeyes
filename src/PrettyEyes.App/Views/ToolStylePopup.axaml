<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.Views.ToolStylePopup">
  <UserControl.Styles>
    <!-- A swatch is a colour and nothing else, so its selected state cannot be
         shown with colour: the ring would vanish on the white one. A tick does
         the job on every swatch in the row. -->
    <Style Selector="Button.swatch">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    </Style>
    <Style Selector="Button.swatch /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
    </Style>

    <Style Selector="Button.step">
      <Setter Property="Height" Value="28"/>
      <!-- Said out loud: a Button left to itself puts its content at the top,
           and the minus of the size stepper sat on the ceiling. -->
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="MinWidth" Value="44"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button.step /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.12"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.step:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
    </Style>
    <Style Selector="Button.step.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillHover}"/>
    </Style>
    <Style Selector="Button.step Rectangle">
      <Setter Property="Fill" Value="{StaticResource TextStrong}"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="RadiusX" Value="2"/>
      <Setter Property="RadiusY" Value="2"/>
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="{StaticResource RCard}"
          Padding="12"
          BoxShadow="{StaticResource Shadow2}"
          Opacity="0">
    <Border.RenderTransform>
      <TranslateTransform Y="6"/>
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.12" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>

    <StackPanel Spacing="12">
      <StackPanel x:Name="Colors" Orientation="Horizontal" Spacing="4"/>

      <Rectangle Height="1" Fill="{StaticResource Border}"/>

      <StackPanel x:Name="StrokeRow" Orientation="Horizontal" Spacing="4">
        <Button Classes="step" x:Name="SmallStep" ToolTip.Tip="Тонкая">
          <Rectangle Height="2"/>
        </Button>
        <Button Classes="step" x:Name="MediumStep" ToolTip.Tip="Средняя">
          <Rectangle Height="3"/>
        </Button>
        <Button Classes="step" x:Name="LargeStep" ToolTip.Tip="Толстая">
          <Rectangle Height="5"/>
        </Button>
      </StackPanel>

      <!-- The text tool has nothing to do with stroke width, so it gets this
           row instead of that one. Both never show at once.

           One column of three short rows rather than a tower: font, then size
           and backdrop side by side. The card used to run twice as tall as the
           others for no reason anybody could name. -->
      <StackPanel x:Name="TextRow" IsVisible="False" Spacing="8">
        <ComboBox x:Name="Fonts" Classes="field" HorizontalAlignment="Stretch"
                  MaxDropDownHeight="260"/>

        <TextBlock x:Name="FontMissing"
                   IsVisible="False"
                   TextWrapping="Wrap"
                   MaxWidth="240"
                   FontSize="11"
                   Foreground="{StaticResource TextDim}"/>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button Classes="step" x:Name="SmallerType" MinWidth="28" ToolTip.Tip="Мельче">
            <TextBlock Text="-"/>
          </Button>
          <Border MinWidth="34" VerticalAlignment="Center">
            <TextBlock x:Name="TypeSize"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextStrong}"/>
          </Border>
          <Button Classes="step" x:Name="BiggerType" MinWidth="28" ToolTip.Tip="Крупнее">
            <TextBlock Text="+"/>
          </Button>

          <Rectangle Width="1" Margin="6,4" Fill="{StaticResource Border}"/>

          <Button Classes="step" x:Name="PlateBackdrop" MinWidth="58" ToolTip.Tip="Подложка под текстом">
            <TextBlock Text="Плашка"/>
          </Button>
          <Button Classes="step" x:Name="OutlineBackdrop" MinWidth="58" ToolTip.Tip="Обводка вместо подложки">
            <TextBlock Text="Обводка"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
