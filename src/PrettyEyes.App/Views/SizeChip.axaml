<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.Views.SizeChip">
  <Border x:Name="Card"
          Background="{StaticResource SurfaceRaised}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="{StaticResource RChip}"
          Padding="6,2"
          Opacity="0">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Border.Transitions>
    <TextBlock x:Name="Label"
               Foreground="{StaticResource TextDim}"
               FontSize="12"
               Text="0 x 0"/>
  </Border>
</UserControl>
