<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.Views.ToolbarView">
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillHover}"/>
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
    </Style>
  </UserControl.Styles>

  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="{StaticResource RCard}"
          Padding="6"
          BoxShadow="{StaticResource Shadow2}"
          Opacity="0">
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
      </Transitions>
    </Border.Transitions>
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Classes="tool active" x:Name="BlurButton">
        <Path Data="M4,4 H6.5 V6.5 H4 Z M9.5,4 H12 V6.5 H9.5 Z M6.5,6.5 H9 V9 H6.5 Z M4,9.5 H6.5 V12 H4 Z M9.5,9.5 H12 V12 H9.5 Z"/>
      </Button>
      <Button Classes="tool" x:Name="ArrowButton">
        <Path Data="M4,12 L12,4 M12,4 H7.5 M12,4 V8.5"/>
      </Button>
      <Button Classes="tool" x:Name="RectButton">
        <Path Data="M3.5,4 H12.5 V12 H3.5 Z"/>
      </Button>
      <Rectangle Width="1" Margin="4,4" Fill="{StaticResource Border}"/>
      <Button Classes="tool" x:Name="UndoButton">
        <Path Data="M6,4.5 L3,7.5 L6,10.5 M3,7.5 H9.5 A3.25,3.25 0 1 1 9.5,14 H7"/>
      </Button>
      <Button Classes="tool" x:Name="CopyButton">
        <Path Data="M6,3 H13 V10 M3,6 H10 V13 H3 Z"/>
      </Button>
      <Button Classes="tool" x:Name="SaveButton">
        <Path Data="M8,3 V10 M5,7.5 L8,10.5 L11,7.5 M3,12.5 H13"/>
      </Button>
    </StackPanel>
  </Border>
</UserControl>
