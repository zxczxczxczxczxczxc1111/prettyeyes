<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.Views.ToolbarView">
  <UserControl.Styles>
    <Style Selector="Button.tool">
      <!-- The toolbar never takes the keyboard. A focused button swallowed the
           bare C that reads a colour, and left a focus ring on a tool the
           pointer had already moved away from. Every action here has a key of
           its own on the window, so nothing is lost by not being tabbable. -->
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Fill}"/>
    </Style>
    <Style Selector="Button.tool.active">
      <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    </Style>
    <Style Selector="Button.tool.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource FillHover}"/>
    </Style>
    <Style Selector="Button.tool.primary /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Accent}"/>
    </Style>
    <Style Selector="Button.tool.primary">
      <!-- Glyph goes dark on the light button; the stroke binds to Foreground. -->
      <Setter Property="Foreground" Value="{StaticResource Surface}"/>
    </Style>
    <Style Selector="Button.tool.primary:pointerover /template/ ContentPresenter">
      <!-- Hover dims the accent instead of brightening it: it is already the
           brightest thing on screen. -->
      <Setter Property="Background" Value="{StaticResource AccentHover}"/>
    </Style>
    <Style Selector="Button.tool Path">
      <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
      <Setter Property="StrokeThickness" Value="1.5"/>
      <Setter Property="StrokeLineCap" Value="Round"/>
      <Setter Property="StrokeJoin" Value="Round"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Stretch" Value="None"/>
    </Style>
  </UserControl.Styles>

  <Panel>
  <Border x:Name="Card"
          Background="{StaticResource Surface}"
          BorderBrush="{StaticResource Border}"
          BorderThickness="1"
          CornerRadius="{StaticResource RCard}"
          Padding="6"
          BoxShadow="{StaticResource Shadow2}"
          Opacity="0">
    <Border.RenderTransform>
      <TranslateTransform Y="8"/>
    </Border.RenderTransform>
    <Border.Transitions>
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
      </Transitions>
    </Border.Transitions>
    <StackPanel Orientation="Horizontal" Spacing="12">
      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" x:Name="BlurButton" ToolTip.Tip="Размытие">
          <Path Data="M4,4 H6.5 V6.5 H4 Z M9.5,4 H12 V6.5 H9.5 Z M6.5,6.5 H9 V9 H6.5 Z M4,9.5 H6.5 V12 H4 Z M9.5,9.5 H12 V12 H9.5 Z"/>
        </Button>
        <Button Classes="tool" x:Name="ArrowButton" ToolTip.Tip="Стрелка, правая кнопка - цвет и толщина">
          <Panel>
            <Path Data="M4,12 L12,4 M12,4 H7.5 M12,4 V8.5"/>
            <!-- The only colour in the interface, and it is not decoration: it
                 is the colour this tool will draw with. -->
            <Ellipse x:Name="ArrowDot" Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-3,-3"/>
          </Panel>
        </Button>
        <Button Classes="tool" x:Name="LineButton" ToolTip.Tip="Линия, правая кнопка - цвет и толщина">
          <Panel>
            <Path Data="M4,12 L12,4"/>
            <Ellipse x:Name="LineDot" Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-3,-3"/>
          </Panel>
        </Button>
        <Button Classes="tool" x:Name="RectButton" ToolTip.Tip="Рамка, правая кнопка - цвет и толщина">
          <Panel>
            <Path Data="M3.5,4 H12.5 V12 H3.5 Z"/>
            <Ellipse x:Name="RectDot" Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-3,-3"/>
          </Panel>
        </Button>
        <Button Classes="tool" x:Name="PencilButton" ToolTip.Tip="Карандаш, правая кнопка - цвет и толщина">
          <Panel>
            <Path Data="M3.5,12.5 L4.2,9.8 L10,4 L12,6 L6.2,11.8 Z M9,5.2 L10.8,7"/>
            <Ellipse x:Name="PencilDot" Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-3,-3"/>
          </Panel>
        </Button>
        <Button Classes="tool" x:Name="MarkerButton" ToolTip.Tip="Маркер, правая кнопка - цвет и толщина">
          <Panel>
            <Path Data="M5.5,9.5 L9.8,5.2 L11.8,7.2 L7.5,11.5 H5.5 Z M3.5,13.5 H12.5"/>
            <Ellipse x:Name="MarkerDot" Width="6" Height="6"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-3,-3"/>
          </Panel>
        </Button>
        <Button Classes="tool" x:Name="EmojiButton" ToolTip.Tip="Эмодзи, правая кнопка - выбрать другой">
          <Panel>
            <!-- Until a glyph is chosen the button shows an outline like every
                 other tool, not an empty square. -->
            <Path x:Name="EmojiOutline"
                  Data="M8,2.5 A5.5,5.5 0 1 0 8.01,2.5 M6,6.5 V7 M10,6.5 V7 M5.5,9.5 A3,3 0 0 0 10.5,9.5"/>
            <Image x:Name="EmojiGlyph" Width="18" Height="18" IsVisible="False"/>
          </Panel>
        </Button>
      </StackPanel>

      <Rectangle Width="1" Margin="0,2" Fill="{StaticResource Border}"/>

      <StackPanel Orientation="Horizontal" Spacing="2">
        <Button Classes="tool" x:Name="UndoButton" ToolTip.Tip="Отменить">
          <Path Data="M6,4.5 L3,7.5 L6,10.5 M3,7.5 H9.5 A3.25,3.25 0 1 1 9.5,14 H7"/>
        </Button>
        <Button Classes="tool" x:Name="SaveButton" ToolTip.Tip="Сохранить в файл">
          <Path Data="M8,3 V10 M5,7.5 L8,10.5 L11,7.5 M3,12.5 H13"/>
        </Button>
        <Button Classes="tool primary" x:Name="CopyButton" ToolTip.Tip="Копировать">
          <Path Data="M6,3 H13 V10 M3,6 H10 V13 H3 Z"/>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
  </Panel>
</UserControl>
