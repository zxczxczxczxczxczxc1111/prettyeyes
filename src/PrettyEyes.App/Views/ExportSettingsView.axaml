<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.Views.ExportSettingsView"
             Width="380">
  <StackPanel Spacing="12">

          <!-- Three results to choose from, not five parameters to tune. The
               parameters are still here, one click down. -->
          <StackPanel x:Name="PresetRow" Orientation="Horizontal" Spacing="6"/>

          <TextBlock x:Name="PresetHint" Foreground="{StaticResource TextFaint}" FontSize="11"
                     TextWrapping="Wrap" IsVisible="False"/>

          <Button x:Name="ExportAdvanced" Classes="ghost" Content="Настроить"
                  HorizontalAlignment="Left"/>

          <StackPanel x:Name="ExportOptions" Spacing="12" Opacity="0.4" IsEnabled="False" IsVisible="False">
            <StackPanel Spacing="8">
              <TextBlock Text="Поля" Foreground="{StaticResource Text}"/>
              <StackPanel x:Name="PaddingRow" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Фон" Foreground="{StaticResource Text}"/>
              <StackPanel x:Name="BackgroundRow" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="Скругление" Foreground="{StaticResource Text}"/>
              <StackPanel x:Name="RadiusRow" Orientation="Horizontal" Spacing="6"/>
            </StackPanel>

            <!-- The three switches and the picture they change, side by side.
                 Stacked, the card ran twice as tall as the others; here the
                 preview stays in sight while a switch is being clicked, which
                 is the whole point of having one. -->
            <Grid ColumnDefinitions="Auto,12,*">
              <StackPanel Grid.Column="0" Spacing="12" VerticalAlignment="Center">
                <CheckBox x:Name="ExportShadow" Content="Тень"/>
                <CheckBox x:Name="ExportGrain" Content="Зерно"/>
                <CheckBox x:Name="ExportSheen" Content="Свет"/>
              </StackPanel>

              <!-- Drawn by the same code that writes the file: a preview that
                   lies is worse than no preview. -->
              <Border Grid.Column="2" Background="{StaticResource Bg}"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RField}"
                    Padding="8"
                    HorizontalAlignment="Right">
                <Image x:Name="ExportPreview" Width="176" Height="110"/>
              </Border>
            </Grid>
          </StackPanel>
  </StackPanel>
</UserControl>
