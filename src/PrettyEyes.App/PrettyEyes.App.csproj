<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Follows PrettyEyes.Platform.Windows: a neutral TFM cannot reference it. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\prettyeyes.ico</ApplicationIcon>
    <!-- The pixel copy is a tight loop over 3.7 million pixels, and the quick
         JIT compiles it without optimisations the first few times: measured 61
         ms against 15 ms once the real compiler caught up. Nothing here starts
         fast enough for that trade to be worth it. -->
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Diagnostics">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrettyEyes.Core\PrettyEyes.Core.csproj" />
    <ProjectReference Include="..\PrettyEyes.Platform.Windows\PrettyEyes.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
