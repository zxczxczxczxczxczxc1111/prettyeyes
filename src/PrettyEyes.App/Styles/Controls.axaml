<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="10" Background="Transparent">
          <Border x:Name="Box"
                  Width="18" Height="18"
                  CornerRadius="6"
                  Background="{StaticResource Fill}"
                  BorderBrush="{StaticResource BorderStrong}"
                  BorderThickness="1">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15"/>
              </Transitions>
            </Border.Transitions>
            <Path x:Name="Check"
                  Data="M3.5,8 L6.5,11 L12.5,4.5"
                  Stroke="{StaticResource Surface}"
                  StrokeThickness="2"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Opacity="0"/>
          </Border>
          <ContentPresenter Content="{TemplateBinding Content}"
                            VerticalAlignment="Center"/>
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="CheckBox:pointerover /template/ Border#Box">
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
  </Style>

  <Style Selector="CheckBox:checked /template/ Border#Box">
    <Setter Property="Background" Value="{StaticResource Accent}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>

  <Style Selector="CheckBox:checked /template/ Path#Check">
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <!-- Ghost button: the only button shape outside the overlay toolbar. -->
  <Style Selector=":is(Button).ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>

  <Style Selector=":is(Button).ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextStrong}"/>
  </Style>

  <!-- The window close glyph: small enough not to argue with the title. -->
  <Style Selector=":is(Button).close">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
  </Style>

  <Style Selector=":is(Button).close:pointerover /template/ ContentPresenter">
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}"/>
  </Style>

  <!-- Tray menu item: a row, not a button, so hover is a film and nothing else. -->
  <Style Selector=":is(Button).menu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>

  <Style Selector=":is(Button).menu /template/ ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>

  <Style Selector=":is(Button).menu:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextStrong}"/>
  </Style>

  <!-- Hotkey field: idle, hover, and "waiting for a key" states. -->
  <Style Selector=":is(Button).field">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RField}"/>
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector=":is(Button).field:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
  </Style>

  <Style Selector=":is(Button).field:focus">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
  </Style>

  <!-- One of several: padding, backdrop, rounding. Reads as a row of options
       where exactly one is on. -->
  <Style Selector=":is(Button).choice">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <Style Selector=":is(Button).choice:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
  </Style>

  <Style Selector=":is(Button).choice.active">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
  </Style>

  <Style Selector=":is(Button).choice.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
  </Style>

  <!-- The toolbar, in miniature, as a row of switches. Square, because the
       content is the tool's own icon: a chip shaped like a label would promise
       a word. Off is faded rather than crossed out - the row then reads as the
       toolbar it is about, with some of it turned down. -->
  <Style Selector=":is(Button).toolpick">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
    <Setter Property="Opacity" Value="0.45"/>
  </Style>

  <Style Selector=":is(Button).toolpick:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
  </Style>

  <Style Selector=":is(Button).toolpick.active">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>

  <Style Selector=":is(Button).toolpick Path">
    <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}"/>
    <Setter Property="StrokeThickness" Value="1.5"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="Width" Value="16"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- The modal card: the same surface and hairline as the settings window
       itself, one step lighter so it reads as lying on top rather than as a
       hole cut in it. -->
  <Style Selector="Border.modalcard">
    <Setter Property="Background" Value="{StaticResource Surface}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RField}"/>
  </Style>

  <Style Selector="TextBlock.modaltitle">
    <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
  </Style>

  <!-- The corner that says "there is something behind the right button here".
       Dim by default; the square lighting up on hover is the invitation. -->
  <Style Selector=":is(Button).corner">
    <Setter Property="Width" Value="12"/>
    <Setter Property="Height" Value="12"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
  </Style>

  <Style Selector=":is(Button).corner:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
  </Style>

  <Style Selector=":is(Button).corner Path">
    <Setter Property="Fill" Value="{Binding $parent[Button].Foreground}"/>
    <Setter Property="Stroke" Value="{x:Null}"/>
    <Setter Property="Width" Value="6"/>
    <Setter Property="Height" Value="6"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <!-- A text field that looks like the hotkey field next to it: same fill,
       same hairline, same radius. The default Avalonia box brings its own
       light theme with it. -->
  <Style Selector="TextBox.field">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RField}"/>
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    <Setter Property="CaretBrush" Value="{StaticResource TextStrong}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource FillHover}"/>
    <Setter Property="Padding" Value="12,10"/>
  </Style>

  <Style Selector="TextBox.field /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  </Style>

  <Style Selector="TextBox.field:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
  </Style>

  <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>
  <!-- The project's first dropdown. It arrives from Fluent in a light theme
       with its own fill, its own chevron and a white popup, so all three are
       said again here in the app's own tokens. Written as a shared style
       rather than a local one: the next section that needs a list should not
       have to discover this again. -->
  <Style Selector="ComboBox.field">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
    <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style Selector="ComboBox.field /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
  </Style>

  <Style Selector="ComboBox.field:pointerover /template/ Border#Background">
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
  </Style>

  <Style Selector="ComboBox.field:focus /template/ Border#Background">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
  </Style>

  <!-- The chevron is a Path in the default template and keeps its own colour
       otherwise: dark grey on dark grey. -->
  <Style Selector="ComboBox.field /template/ Path#DropDownGlyph">
    <Setter Property="Fill" Value="{StaticResource TextDim}"/>
  </Style>

  <!-- The list itself is a separate popup and inherits none of the above. -->
  <Style Selector="ComboBox.field /template/ Border#PopupBorder">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RField}"/>
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="{StaticResource RChip}"/>
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource FillHover}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextStrong}"/>
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Fill}"/>
    <Setter Property="TextElement.Foreground" Value="{StaticResource TextStrong}"/>
  </Style>

</Styles>
