<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PrettyEyes.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/Tokens.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/prettyeyes.ico" ToolTipText="prettyeyes">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Снимок" Click="Capture_OnClick"/>
                        <NativeMenuItem Header="Настройки" Click="Settings_OnClick"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Выход" Click="Exit_OnClick"/>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="/Styles/Controls.axaml"/>
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Application.Styles>
</Application>
